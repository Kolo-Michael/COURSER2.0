# Database — Neon PostgreSQL (pooler endpoint).
#
# The app uses SQLAlchemy's async engine with the asyncpg driver, so the
# scheme MUST be `postgresql+asyncpg://` (config.normalize_database_url will
# rewrite a bare `postgresql://` to this, but writing the driver segment
# directly is clearer).
#
# sslmode=require is required for Neon — the host terminates TLS and will
# refuse plain-text connections. The app auto-detects this and sets
# `connect_args={"ssl": True}` on the asyncpg engine.
#
# channel_binding=require is fine to leave in; config.normalize_database_url
# strips it (and sslmode) from the query string before handing the URL to
# SQLAlchemy, so it never reaches the driver in a way that could confuse it.
#
# Example (Neon pooler endpoint — recommended for free / serverless apps):
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/Courser?sslmode=require

# Security — JWT signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Must match the value used by every other environment that issues tokens
# for the same user base (e.g. Render's SECRET_KEY env var).
SECRET_KEY=replace-with-a-long-random-secret
